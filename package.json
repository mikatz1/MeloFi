{
  "name": "melofi",
  "version": "0.3.0",
  "description": "Virtual piano with a visualizer, score playback and practice",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set MELOFI_DEV=1&& electron .",
    "build:instruments": "node tools/build-instruments.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "server": "node server/index.mjs"
  },
  "author": "mikatz1",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "linkedom": "^0.18.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lamejs": "^1.2.1",
    "mp4-muxer": "^5.2.2"
  },
  "productName": "MeloFi",
  "private": true,
  "build": {
    "appId": "io.github.mikatz1.melofi",
    "productName": "MeloFi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "daw.js",
      "account.js",
      "studio-files.js",
      "vocal.js",
      "stems.js",
      "engine-install.js",
      "vsthost.js",
      "crashlog.js",
      "updater.js",
      "report.js",
      "i18n-main.js",
      "tools/vocal/svs_render.py",
      "tools/stems/analyze.py",
      "tools/stems/instruments.py",
      "tools/stems/engine/**",
      "package.json",
      "renderer/**/*",
      "!renderer/_test/**",
      "instruments/*/manifest.json",
      "instruments/splendid/s/**"
    ],
    "asarUnpack": [
      "lib/unpack/**",
      "tools/vocal/**",
      "tools/stems/**",
      "instruments/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MeloFi",
      "installerIcon": "renderer/assets/icon.ico",
      "uninstallerIcon": "renderer/assets/icon.ico",
      "artifactName": "MeloFi-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "native/build/MeloFiVstHost_artefacts/Release/MeloFi VST Host.exe",
        "to": "vsthost/MeloFi VST Host.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mikatz1",
        "repo": "MeloFi",
        "releaseType": "release"
      }
    ]
  }
}
